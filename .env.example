# Copy this file to .env and fill in real values. Never commit .env.

# --- AI Image Generation (src/app/api/ai/image) ---
# Required. Server-only — never exposed to the browser.
OPENAI_API_KEY=

# Optional. Global daily cap on image generations, across all IPs. Defaults to 200.
AI_IMAGE_DAILY_LIMIT=

# --- Analytics (src/app/layout.tsx) ---
# Optional. If unset, no analytics script loads at all (no fake/mock tracking).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Business info (src/presentation/config/site.ts) ---
# Optional. Only set these if there is a real physical storefront address to
# publish in SEO metadata (JSON-LD). Leave unset otherwise.
NEXT_PUBLIC_BUSINESS_STREET_ADDRESS=
NEXT_PUBLIC_BUSINESS_POSTAL_CODE=
